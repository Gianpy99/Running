# Environment for the AI Running Coach container.
# Copy to `.env` for local docker-compose / manual runs. NEVER commit the real .env.
# In the Family Portal, DATABASE_URL is injected by Jenkins credentials, not a file.

# Shared PostgreSQL on the Raspberry Pi (native PostgreSQL 15, one database per app).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://running_coach:CHANGE_ME@192.168.1.129:5432/running_coach

# Seed the bundled regression fixtures on first run if the DB is empty (1=yes, 0=no).
COACH_AUTO_SEED=1

# Local SQLite fallback (used only when DATABASE_URL is unset).
COACH_DB=/app/data/coach.db
