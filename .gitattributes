# Force LF line endings for shell scripts and container files so they work when
# checked out on Linux (the Raspberry Pi / Docker build). Prevents CRLF breaking
# the entrypoint shebang.
* text=auto eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
docker-entrypoint.sh text eol=lf
Jenkinsfile text eol=lf
*.groovy text eol=lf

# Windows-specific files keep CRLF
*.ps1 text eol=crlf
